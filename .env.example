# Copy to .env (git-ignored) and fill in. Only GROQ_API_KEY is required.
GROQ_API_KEY=
# Optional: a second Groq key used for gpt-oss-120b (each Groq account has its own daily free-tier quota)
GROQ_API_KEY_2=
# Optional: route gpt-oss-120b through OpenRouter (needs account credit)
OPENROUTER_API_KEY=
# Optional: only for claude-* generator models (RAG_GEN_MODEL=claude-haiku-5-5)
ANTHROPIC_API_KEY=
