{"config": "B-dense-gptoss20b", "qid": "A22", "type": "answerable", "version_sensitive": false, "answer": "The consent obtained by an account aggregator must be a standardised consent artefact. It must contain the customer’s identity and optional contact information; the nature of the financial information requested; the purpose of collecting such information; the identity of the recipients of the information, if any; the URL or other address to which a notification must be sent every time the artefact is used to access information; the consent creation date, expiry date, identity and signature/digital signature of the NBFC‑AA; and any other attribute prescribed by the Reserve Bank. The artefact may be obtained in electronic form and must be capable of being logged, audited and verified.", "citations": ["D13_B_0015"], "refused": false, "refusal_reason": "", "invalid_citations": [], "superseded_cited": [], "injection_detected": false, "cost_usd": 0.000168, "gen_latency_s": 1.1572632999886991, "rate_limit_wait_s": 0.0, "usage": {"input_tokens": 1768, "output_tokens": 214, "cache_read_input_tokens": 768, "billed_cost_usd": 0.000168, "provider": "Groq", "via": "openrouter"}, "retrieved": ["D13_B_0024", "D13_B_0014", "D13_B_0015", "D13_B_0016", "D13_B_0017"], "retrieval_latency_s": 0.03819330000260379, "total_latency_s": 1.1955637000064598, "hit@5": 1, "rr@10": 0.3333333333333333, "first_hit_rank": 3, "gold_cited": true}
