{"config": "A-dense-gptoss20b", "qid": "A17", "type": "answerable", "version_sensitive": false, "answer": "The minimum validity period of a PPI is one year from the date of last loading/reloading.", "citations": ["D11_A_0032"], "refused": false, "refusal_reason": "", "invalid_citations": [], "superseded_cited": [], "injection_detected": false, "cost_usd": 0.00023459999999999998, "gen_latency_s": 1.3669618999992963, "rate_limit_wait_s": 0.0, "usage": {"input_tokens": 2740, "output_tokens": 97, "cache_read_input_tokens": 0, "billed_cost_usd": 0.0002346, "provider": "Groq", "via": "openrouter"}, "retrieved": ["D11_A_0032", "D11_A_0005", "D11_A_0033", "D11_A_0004", "D11_A_0006"], "retrieval_latency_s": 0.07928420000098413, "total_latency_s": 1.4464105000006384, "hit@5": 1, "rr@10": 1.0, "first_hit_rank": 1, "gold_cited": true}
{"config": "A-dense-gptoss20b", "qid": "A18", "type": "answerable", "version_sensitive": false, "answer": "The maximum amount outstanding that may be held in a full‑KYC prepaid payment instrument is Rs. 2,00,000/- at any point in time.", "citations": ["D11_A_0018", "D11_A_0037"], "refused": false, "refusal_reason": "", "invalid_citations": [], "superseded_cited": [], "injection_detected": false, "cost_usd": 0.000243375, "gen_latency_s": 1.3368283000017982, "rate_limit_wait_s": 0.0, "usage": {"input_tokens": 2749, "output_tokens": 188, "cache_read_input_tokens": 512, "billed_cost_usd": 0.000243375, "provider": "Groq", "via": "openrouter"}, "retrieved": ["D11_A_0019", "D11_A_0020", "D11_A_0018", "D11_A_0037", "D11_A_0016"], "retrieval_latency_s": 0.08989570000267122, "total_latency_s": 1.4268901999967056, "hit@5": 1, "rr@10": 0.3333333333333333, "first_hit_rank": 3, "gold_cited": true}
{"config": "A-dense-gptoss20b", "qid": "A19", "type": "answerable", "version_sensitive": false, "answer": "No, funds transfer or cash withdrawal is not permitted from a small PPI.", "citations": ["D11_A_0003"], "refused": false, "refusal_reason": "", "invalid_citations": [], "superseded_cited": [], "injection_detected": false, "cost_usd": 0.00023467499999999997, "gen_latency_s": 1.2224491000015405, "rate_limit_wait_s": 0.0, "usage": {"input_tokens": 2653, "output_tokens": 119, "cache_read_input_tokens": 0, "billed_cost_usd": 0.000234675, "provider": "Groq", "via": "openrouter"}, "retrieved": ["D11_A_0003", "D11_A_0019", "D11_A_0016", "D11_A_0017", "D11_A_0057"], "retrieval_latency_s": 0.08314450000034412, "total_latency_s": 1.3057196000008844, "hit@5": 1, "rr@10": 1.0, "first_hit_rank": 1, "gold_cited": true}
{"config": "A-dense-gptoss20b", "qid": "A20", "type": "answerable", "version_sensitive": false, "answer": "An NBFC‑Account Aggregator must have a net owned fund of at least ₹2 crore.", "citations": ["D13_A_0006"], "refused": false, "refusal_reason": "", "invalid_citations": [], "superseded_cited": [], "injection_detected": false, "cost_usd": 0.00024255, "gen_latency_s": 1.2193270999996457, "rate_limit_wait_s": 0.0, "usage": {"input_tokens": 2834, "output_tokens": 100, "cache_read_input_tokens": 0, "billed_cost_usd": 0.00024255, "provider": "Groq", "via": "openrouter"}, "retrieved": ["D13_A_0006", "D13_A_0012", "D13_A_0007", "D13_A_0008", "D13_A_0017"], "retrieval_latency_s": 0.0837344999963534, "total_latency_s": 1.3032786999974633, "hit@5": 1, "rr@10": 1.0, "first_hit_rank": 1, "gold_cited": true}
{"config": "A-dense-gptoss20b", "qid": "A21", "type": "answerable", "version_sensitive": false, "answer": "No. An Account Aggregator (NBFC‑AA) is a purely information‑technology driven entity and is not permitted to handle or process payment transactions for its customers.", "citations": ["D13_A_0012"], "refused": false, "refusal_reason": "", "invalid_citations": [], "superseded_cited": [], "injection_detected": false, "cost_usd": 0.0002247, "gen_latency_s": 1.314120399998501, "rate_limit_wait_s": 0.0, "usage": {"input_tokens": 2496, "output_tokens": 125, "cache_read_input_tokens": 0, "billed_cost_usd": 0.0002247, "provider": "Groq", "via": "openrouter"}, "retrieved": ["D06_A_0002", "X01_A_0000", "D06_A_0003", "D13_A_0012", "D11_A_0029"], "retrieval_latency_s": 0.08298780000041006, "total_latency_s": 1.3972557000015513, "hit@5": 0, "rr@10": 0.0, "first_hit_rank": null, "gold_cited": false}
{"config": "A-dense-gptoss20b", "qid": "A22", "type": "answerable", "version_sensitive": false, "answer": "The customer’s consent must be captured as a standardised consent artefact that includes:\n1. identity of the customer and optional contact information;\n2. the nature of the financial information requested;\n3. purpose of collecting the information;\n4. identity of the recipients of the information, if any;\n5. a URL or other address to which notification needs to be sent every time the consent artefact is used to access information;\n6. consent creation date, expiry date, identity and signature/digital signature of the NBFC‑AA; and\n7. any other attribute prescribed by the Reserve Bank.", "citations": ["D13_A_0010"], "refused": false, "refusal_reason": "", "invalid_citations": [], "superseded_cited": [], "injection_detected": false, "cost_usd": 0.000251475, "gen_latency_s": 1.8357765000037034, "rate_limit_wait_s": 0.0, "usage": {"input_tokens": 2809, "output_tokens": 200, "cache_read_input_tokens": 512, "billed_cost_usd": 0.000251475, "provider": "Groq", "via": "openrouter"}, "retrieved": ["D13_A_0012", "D13_A_0011", "D13_A_0010", "D13_A_0003", "D13_A_0009"], "retrieval_latency_s": 0.08790530000260333, "total_latency_s": 1.9238288999986253, "hit@5": 1, "rr@10": 0.3333333333333333, "first_hit_rank": 3, "gold_cited": true}
