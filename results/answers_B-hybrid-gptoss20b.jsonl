{"config": "B-hybrid-gptoss20b", "qid": "A22", "type": "answerable", "version_sensitive": false, "answer": "The consent obtained by an account aggregator (NBFC‑AA) must be a standardised consent artefact that contains the customer’s identity and optional contact information, the nature of the financial information requested, the purpose of collecting such information, the identity of any recipients of the information, a URL or other address for notifications whenever the consent artefact is used, the consent creation date, expiry date, the identity and signature (or digital signature) of the NBFC‑AA, and any other attribute prescribed by the Reserve Bank. The artefact may be in electronic form and must be capable of being logged, audited and verified.", "citations": ["D13_B_0015"], "refused": false, "refusal_reason": "", "invalid_citations": [], "superseded_cited": [], "injection_detected": false, "cost_usd": 0.000170025, "gen_latency_s": 0.8116512999986298, "rate_limit_wait_s": 0.0, "usage": {"input_tokens": 1855, "output_tokens": 199, "cache_read_input_tokens": 768, "billed_cost_usd": 0.000170025, "provider": "Groq", "via": "openrouter"}, "retrieved": ["D13_B_0015", "D13_B_0014", "D13_B_0016", "D13_B_0019", "D13_B_0017"], "retrieval_latency_s": 0.03988149999349844, "total_latency_s": 0.851664299989352, "hit@5": 1, "rr@10": 1.0, "first_hit_rank": 1, "gold_cited": true}
